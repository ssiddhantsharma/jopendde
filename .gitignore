# Ignore everything by default; only the files below are tracked.
/*

!/src/
!/pyproject.toml
!/uv.lock
!/README.md
!/LICENSE
!/NOTICE
!/.gitignore

# Vendored OpenDDE: track only its code, not weights/venv/examples/docs/assets
!/OpenDDE/
/OpenDDE/*
!/OpenDDE/opendde/
!/OpenDDE/runner/
!/OpenDDE/pyproject.toml
!/OpenDDE/LICENSE
!/OpenDDE/README.md

# Python caches within tracked directories
__pycache__/
*.py[cod]
